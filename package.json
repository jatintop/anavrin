{
  "name": "anavrin-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "eval:check": "tsx scripts/eval-bills.ts --check",
